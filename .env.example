# Variable NAMES only. Never commit real values.
# Copy to .env.local (git-ignored) or set in the provider's secret store.

# Mobile/web client (EXPO_PUBLIC_* is bundled into the app and is public by design).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin only. NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_; never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=
