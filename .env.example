# Variable NAMES only. Never commit real values.
# Copy to .env.local (git-ignored) or set in the provider's secret store.

# Mobile/web client (EXPO_PUBLIC_* is bundled into the app and is public by design).
# Open Stall project URL (not secret): https://xzzbcejgprilmolvdaes.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin only. NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_; never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (public, not secret). Defaults to public OpenStreetMap tiles: development only.
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=

# Importer (operator machine only; NEVER commit values). SUPABASE_URL is public; the service-role key is a secret.
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is listed above.
OVERPASS_URL=
